{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CCRQS review response v1.0",
  "description": "Единый формат ответа модели для пилота code review Python-кода.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issues"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "issues": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "line_start",
          "line_end",
          "category",
          "severity",
          "comment",
          "proposed_patch",
          "confidence"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Путь к исходному файлу относительно корня репозитория."
          },
          "line_start": {
            "type": "integer",
            "minimum": 1,
            "description": "Первая строка проблемного участка в исходной версии файла."
          },
          "line_end": {
            "type": "integer",
            "minimum": 1,
            "description": "Последняя строка проблемного участка в исходной версии файла."
          },
          "category": {
            "type": "string",
            "enum": ["functional", "runtime", "security", "syntax", "style", "other"]
          },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "comment": {
            "type": "string",
            "description": "Текст замечания, объясняющий проблему и предлагаемое действие."
          },
          "proposed_patch": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ],
            "description": "Unified diff или null, если модель не предложила исправление."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Самооценка уверенности модели, не используемая в базовом CCRQS."
          }
        }
      }
    }
  }
}
